	column 'Houve Apuração no Mês?'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 539dc483-3908-4ee4-a8b6-bd9192a7c6ad
		summarizeBy: none
		sourceColumn: Houve Apuração no Mês?

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Última Apuração Esperada' = ```
			
			VAR periodicidade = LOOKUPVALUE(Indicador[Periodicidade], Indicador[Código Indicador], 'Indicador Apuração'[Código Indicador])
			VAR periodicidade_num = 
			    SWITCH(periodicidade,
			        "Mensal", 1,
			        "Bimestral", 2,
			        "Trimestral", 3,
			        "Quadrimestral", 4,
			        "Semestral", 6,
			        12
			    )
			RETURN DATE(YEAR([Mês Apuração]), CEILING(MONTH([Mês Apuração]) / periodicidade_num, 1) * periodicidade_num, 1)
			```
		formatString: mmmm" de "yyyy
		lineageTag: 582b89bf-557a-4ad1-8c5f-0ee514b18caf
		summarizeBy: none

		variation Variation
			isDefault
			relationship: af52f5d8-050b-487f-82e0-a62862483b8b
			defaultHierarchy: LocalDateTable_ff886ec6-5530-46a4-bf36-cf3660e514ff.'Hierarquia de datas'

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column 'Indicador Descontinuado?' =
			NOT(ISBLANK(
			    CALCULATE(
			        MAX('Indicador Descontinuado'[Fim]),
			        FILTER(
			            'Indicador Descontinuado',
			            'Indicador Descontinuado'[Código Indicador] = 'Indicador Apuração'[Código Indicador]
			                && 'Indicador Descontinuado'[Início] <= 'Indicador Apuração'[Mês Apuração]
			                && 'Indicador Descontinuado'[Fim] >= 'Indicador Apuração'[Mês Apuração]
			        )
			    )
			))
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: d3701171-c5dd-466f-9a8f-fccbe6efcb28
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'É Último Mês de Apuração?' = 'Indicador Apuração'[Mês Apuração] = MAX('Indicador Apuração'[Mês Apuração])
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 003129e8-3249-4b54-9d10-db14a56e6888
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'É Última Apuração do Ano?' = 'Indicador Apuração'[Mês Apuração] == CALCULATE(MAX('Indicador Apuração'[Mês Apuração]), ALLEXCEPT('Indicador Apuração', 'Indicador Apuração'[Ano Apuração]))
		lineageTag: cc6a209e-888d-4a4e-a353-e9f9f75f6ccc
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Ano Apuração' = YEAR('Indicador Apuração'[Mês Apuração])
		formatString: 0
		lineageTag: f0b323d9-c355-453f-9301-42edf5044e11
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column '% Ajustado Cumprimento da Meta do Ano' = IF('Indicador Apuração'[Percentual de Cumprimento da Meta do Ano] > 3, 3, 'Indicador Apuração'[Percentual de Cumprimento da Meta do Ano])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1162b8d2-c417-48b8-9d8e-a6dbcf1ca600
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Apuração Não Realizada Indevidamente' = AND(NOT('Indicador Apuração'[Indicador Descontinuado?]), AND(NOT('Indicador Apuração'[Houve Apuração no Mês?]), 'Indicador Apuração'[Última Apuração Esperada] = 'Indicador Apuração'[Mês Apuração]))
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 444e4151-7667-41f4-afca-2a2639c4ac1e
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Liquidado no Ano / Dotação Atualizada (em %)'
		dataType: double
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a865f30c-27f0-44d2-b987-372302f2ce61
		summarizeBy: none
		sourceColumn: Liquidado no Ano / Dotação Atualizada (em %)

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Apuração Física / Execução Orçamentária' = IF(ISBLANK('Indicador Apuração'[Liquidado no Ano / Dotação Atualizada (em %)]), 'Indicador Apuração'[Liquidado no Ano / Dotação Atualizada (em %)], IF('Indicador Apuração'[Percentual de Cumprimento da Meta do Ano]/'Indicador Apuração'[Liquidado no Ano / Dotação Atualizada (em %)] > 10, 10, 'Indicador Apuração'[Percentual de Cumprimento da Meta do Ano]/'Indicador Apuração'[Liquidado no Ano / Dotação Atualizada (em %)]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d8dbef81-14b8-4612-b9bf-c0041c646a9f
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Código Produto'
		dataType: int64
		formatString: 0
		lineageTag: 3744d7e8-c317-48cf-ab10-b0be5db4d23e
		summarizeBy: none
		sourceColumn: Código Produto

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'ID Apuração' = CONCATENATE('Indicador Apuração'[Código Produto], 'Indicador Apuração'[Mês Apuração])
		lineageTag: 0f7b38d1-ad36-4e07-9e43-19f312999374
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Índice de Defasagem de Apuração Física' = ABS('Indicador Apuração'[Percentual de Cumprimento da Meta do Ano]-'Indicador Apuração'[Percentual de Cumprimento Esperado da Meta do Ano])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9904627d-301f-4a0c-b3a4-5b320133809e
		summarizeBy: sum

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Resultado do Ano Satisfatório?' =
			ISBLANK('Indicador Apuração'[Meta Esperada no Ano]) || ('Indicador Apuração'[Percentual de Cumprimento da Meta do Ano] > _Medidas[Percentual Mínimo de Execução de Meta Física]
			        && 'Indicador Apuração'[Percentual de Cumprimento da Meta do Ano] < _Medidas[Percentual Máximo de Execução de Meta Física])
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 59d4af08-c38d-4e6b-832b-0102dc653bf5
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

