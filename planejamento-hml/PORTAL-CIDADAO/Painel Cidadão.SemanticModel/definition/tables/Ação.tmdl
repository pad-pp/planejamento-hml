	column 'Programa e Produto para Busca Textual' = LOOKUPVALUE(Programa[Código e Nome Programa], Programa[Código Programa], 'Ação'[Código Programa]) & " " & LOOKUPVALUE(Produto[Código e Nome Produto], Produto[Código Produto], 'Ação'[Código Produto]) & " " & 'Ação'[Código e Nome Ação]
