	column 'É Última Apuração do Ano?' = 'Ação Apuração'[Mês Apuração] == CALCULATE(MAX('Ação Apuração'[Mês Apuração]), FILTER('Ação Apuração', 'Ação Apuração'[Código Ação] = EARLIER('Ação Apuração'[Código Ação])))
