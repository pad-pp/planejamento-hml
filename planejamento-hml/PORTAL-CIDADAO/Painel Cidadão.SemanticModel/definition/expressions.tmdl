		    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
		    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"Código Indicador", Int64.Type}, {"Ano", Int64.Type}, {"Código Fase", Int64.Type}, {"Sigla Fase", type text}, {"Meta Anual", type number}}),
		    #"Personalização Adicionada" = Table.AddColumn(#"Tipo Alterado", "Tipo Meta", each "Anual"),
